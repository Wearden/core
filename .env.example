# Local isolated development only. Replace placeholders before running compose.
POSTGRES_USER=wearden
POSTGRES_DB=wearden
POSTGRES_PASSWORD=CHANGE-ME-TO-A-RANDOM-PASSWORD
# Base64-encoded 32 random bytes. Used by the new Go AES-GCM vault; not legacy FERNET_KEY.
WEARDEN_VAULT_KEY=
# Exactly 32 random ASCII characters, required only for optional remote sessions.
GUAC_CONTROL_KEY=
GUAC_CRYPT_KEY=
# Optional fallback: an administrator can set the AI key/model under Settings in the UI instead (sealed with WEARDEN_VAULT_KEY).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
PUBLIC_ORIGIN=http://localhost:8080
# Directory with wearden-agent-linux-amd64 and SHA256SUMS served at /downloads for the one-line agent install.
AGENT_DOWNLOADS_DIR=/data/downloads
# Host-side sibling checkout mounted read-only in core.
RULESET_PATH=../ruleset
